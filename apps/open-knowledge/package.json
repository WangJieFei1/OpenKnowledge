{
	"name": "open-knowledge",
	"private": true,
	"version": "0.0.4",
	"productName": "Open Knowledge",
	"description": "Open-source desktop workspace for local knowledge and project memory",
	"author": "OpenKnowledgeApp",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"desktopName": "open-knowledge.desktop",
	"config": {
		"forge": "./forge.config.ts"
	},
	"main": "dist-electron/main.mjs",
	"engines": {
		"node": ">=22.17"
	},
	"files": [
		"build",
		"dist-electron"
	],
	"scripts": {
		"dev": "bun --bun vite dev",
		"dev:system": "OPEN_KNOWLEDGE_USE_SYSTEM_ELECTRON=1 bun --bun vite dev",
		"prebuild": "bun scripts/clean-build.ts && bun run semantic:prepare",
		"build": "bun --bun vite build",
		"build:app": "bun run build && node node_modules/@electron-forge/cli/dist/electron-forge.js make",
		"build:dir": "bun run build && node node_modules/@electron-forge/cli/dist/electron-forge.js package",
		"build:linux": "bun run build && node node_modules/@electron-forge/cli/dist/electron-forge.js make --platform=linux",
		"build:mac": "bun run build && node node_modules/@electron-forge/cli/dist/electron-forge.js make --platform=darwin",
		"dev:general": "OPEN_KNOWLEDGE_EDITION=general bun run dev",
		"dev:codex": "OPEN_KNOWLEDGE_EDITION=codex bun run dev",
		"build:general": "OPEN_KNOWLEDGE_EDITION=general bun run build",
		"build:codex": "OPEN_KNOWLEDGE_EDITION=codex bun run build",
		"build:mac:general": "OPEN_KNOWLEDGE_EDITION=general bun run build:mac",
		"build:mac:codex": "OPEN_KNOWLEDGE_EDITION=codex bun run build:mac",
		"build:mac:editions": "bun run build:mac:general && bun run build:mac:codex",
		"build:mac:release": "bash scripts/release-macos.sh",
		"build:win": "bun run build && node node_modules/@electron-forge/cli/dist/electron-forge.js make --platform=win32",
		"build:win:release": "powershell.exe -NoProfile -File scripts/release-windows.ps1",
		"start": "electron .",
		"preview": "bun --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit --project electron/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test",
		"lint": "prettier --check . && eslint .",
		"format": "eslint . --fix && prettier --write .",
		"semantic:prepare": "bun scripts/semantic-assets.ts",
		"predev": "bun run semantic:prepare",
		"predev:system": "bun run semantic:prepare",
		"test:semantic": "bun run build && bun build scripts/semantic-network-guard.ts --target=node --outfile=.cache/semantic-network-guard.mjs && bun build scripts/semantic-smoke.ts --target=node --outfile=.cache/semantic-smoke.mjs && node .cache/semantic-smoke.mjs && bun run test:semantic:runtime",
		"test:semantic:runtime": "bun build scripts/semantic-runtime-smoke.ts --target=node --outfile=.cache/semantic-runtime-smoke.mjs && node .cache/semantic-runtime-smoke.mjs",
		"test:semantic:electron": "bun build scripts/semantic-electron-smoke.ts --external=electron --target=node --outfile=.cache/semantic-electron-smoke.mjs && electron .cache/semantic-electron-smoke.mjs",
		"test:edition:electron": "bun build scripts/edition-electron-smoke.ts --external=electron --target=node --outfile=.cache/edition-electron-smoke.mjs && electron .cache/edition-electron-smoke.mjs"
	},
	"devDependencies": {
		"@electron-forge/cli": "8.0.1",
		"@electron-forge/maker-dmg": "8.0.1",
		"@electron-forge/maker-squirrel": "8.0.1",
		"@electron-forge/maker-zip": "8.0.1",
		"@electron-forge/plugin-fuses": "8.0.1",
		"@electron-forge/shared-types": "8.0.1",
		"@electron/fuses": "2.1.3",
		"@eslint/js": "^10.0.1",
		"@open-knowledge/knowledge-bundle-remote-test": "workspace:*",
		"@reforged/maker-appimage": "^6.0.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@sveltejs/adapter-static": "4.0.0-next.4",
		"@sveltejs/kit": "3.0.0-next.25",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.0",
		"@types/electron-squirrel-startup": "^1.0.2",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^26.1.1",
		"electron": "^43.8.11",
		"eslint": "^10.8.0",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"node-gyp": "12.4.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"vite-plugin-electron": "1.1.0"
	},
	"dependencies": {
		"@firecrawl/anydoc-wasm": "0.1.7",
		"@floating-ui/dom": "^1.8.0",
		"@hono/node-server": "^2.0.12",
		"@huggingface/tokenizers": "0.2.0",
		"@modelcontextprotocol/client": "2.4.0",
		"@modelcontextprotocol/server": "2.4.0",
		"@open-knowledge/knowledge-bundle": "workspace:*",
		"@open-knowledge/knowledge-bundle-api": "workspace:*",
		"@open-knowledge/knowledge-bundle-filesystem": "workspace:*",
		"@open-knowledge/knowledge-bundle-mcp": "workspace:*",
		"@open-knowledge/knowledge-bundle-patch": "workspace:*",
		"@radix-ui/colors": "^3.0.0",
		"bits-ui": "2.18.1",
		"capnweb": "^0.10.0",
		"electron-squirrel-startup": "^1.0.1",
		"hono": "^4.12.32",
		"jsonc-parser": "^3.3.1",
		"lucide-svelte": "^1.0.1",
		"markdown-it": "^14.3.3",
		"onnxruntime-node": "1.30.0",
		"prosemirror-commands": "^1.7.1",
		"prosemirror-history": "^1.5.0",
		"prosemirror-inputrules": "^1.5.1",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-markdown": "^1.13.5",
		"prosemirror-model": "^1.25.11",
		"prosemirror-schema-list": "^1.5.1",
		"prosemirror-state": "^1.4.4",
		"prosemirror-tables": "^1.8.5",
		"prosemirror-view": "^1.42.9",
		"ripgrep": "0.3.1",
		"valibot": "^1.4.2",
		"yaml": "^2.9.0"
	}
}
